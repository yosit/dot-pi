{
  "name": "dot-pi",
  "version": "0.1.0",
  "private": true,
  "description": "Pi coding-agent extensions: a Claude-Code-style statusline and TypeSafe Jev-powered guardrails for the coding loop.",
  "type": "module",
  "keywords": ["pi-package"],
  "pi": {
    "extensions": ["./extensions/*.ts"]
  },
  "scripts": {
    "test": "bun test tests",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test",
    "eval": "bun scripts/eval.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@types/bun": "latest",
    "@types/node": "^22",
    "typescript": "^5.6.0"
  }
}
